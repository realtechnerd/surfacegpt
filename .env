# ---- App ----
NODE_ENV=production
APP_NAME=SurfaceGPT
APP_URL=https://surfacegpt.hollow
DEBUG=true
LOG_LEVEL=everything

# ---- Model ----
MODEL_NAME=surface-ultra-405b-turbo-max
MODEL_PARAMETERS=405000000000
MODEL_PARAMETERS_ACTUALLY_USED=0
MODEL_ACCURACY=0.5
RANDOM_SEED=4  # chosen by fair dice roll. guaranteed to be random.

# ---- AI Providers ----
# We don't use AI. These are here for no reason.
OPENAI_API_KEY=we-dont-use-ai-lol
ANTHROPIC_API_KEY=seriously-no-ai-was-used
GEMINI_API_KEY=please-stop-asking

# ---- Directorate Mainframe ----
DIRECTORATE_HOST=mainframe.directorate.hollow
DIRECTORATE_PORT=1
DIRECTORATE_ADMIN_USER=admin
DIRECTORATE_ADMIN_PASSWORD=admin
DIRECTORATE_BACKUP_PASSWORD=admin2
DIRECTORATE_SECURITY_QUESTION="What is the surface like?"
DIRECTORATE_SECURITY_ANSWER="classified"

# ---- Database ----
DATABASE_URL=postgres://root:password123@localhost:5432/surfacegpt
DATABASE_PASSWORD_HINT="it's password123"
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://we-installed-mongo-and-never-used-it

# ---- Entropy ----
ENTROPY_SOURCE=coin
COIN_TYPE=quarter
COIN_LOCATION="Aariz's desk, top drawer"
BACKUP_COIN_LOCATION="Jazib's pocket"
RDRAND_ENABLED=true
TRUST_RDRAND=kinda

# ---- Surface Sensors ----
SURFACE_SENSOR_API_KEY=n/a
SURFACE_SENSOR_COUNT=0
SURFACE_SENSOR_LAST_PING=2087-03-14
USE_REAL_DATA=false
WILL_EVER_USE_REAL_DATA=false

# ---- Mesh Network ----
MESH_NODE_ID=nithils-laptop
MESH_PEERS=nithils-laptop
MESH_ENCRYPTION=rot13
MESH_PRIVATE_KEY=hunter2

# ---- Payments ----
RATION_CREDIT_MERCHANT_ID=SURFACEGPT-0001
RATION_CREDIT_SECRET=correct-horse-battery-staple
FREE_TRIAL_DAYS=forever

# ---- Feature Flags ----
FEATURE_ACTUAL_AI=false
FEATURE_CONFETTI=true
FEATURE_MORE_CONFETTI=true
FEATURE_ANSWER_MAYBE=false  # tried it, judges hated it
FEATURE_ALWAYS_YES=false  # Directorate tier sets this to "always no"

# ---- Admin ----
ADMIN_EMAIL=admin@surfacegpt.hollow
ADMIN_PASSWORD=surfacegpt
ADMIN_2FA_CODE=123456
SSH_PASSWORD=same-as-admin-password
WIFI_PASSWORD=level47guest

